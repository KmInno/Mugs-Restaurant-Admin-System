<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sales Print - <%= new Date().toLocaleDateString() %></title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Courier New', monospace;
      background: white;
      padding: 20px;
      color: #000;
    }

    .print-container {
      max-width: 80mm;
      margin: 0 auto;
      background: white;
    }

    .header {
      text-align: center;
      margin-bottom: 20px;
      border-bottom: 2px dashed #000;
      padding-bottom: 10px;
    }

    .header h1 {
      font-size: 16px;
      font-weight: bold;
      margin-bottom: 5px;
    }

    .header .date-time {
      font-size: 11px;
      color: #333;
    }

    .order-item {
      margin-bottom: 15px;
      padding-bottom: 10px;
      border-bottom: 1px dashed #999;
    }

    .order-item:last-child {
      border-bottom: 2px dashed #000;
    }

    .order-row {
      font-size: 11px;
      line-height: 1.5;
      margin-bottom: 3px;
    }

    .label {
      font-weight: bold;
      display: inline-block;
      width: 50px;
    }

    .value {
      display: inline-block;
      flex: 1;
      word-break: break-word;
    }

    .amount {
      font-size: 12px;
      font-weight: bold;
      text-align: right;
      margin-top: 5px;
    }

    .summary {
      margin-top: 20px;
      text-align: center;
      border-top: 2px dashed #000;
      border-bottom: 2px dashed #000;
      padding: 10px 0;
    }

    .summary-row {
      font-size: 12px;
      font-weight: bold;
      margin: 5px 0;
    }

    .footer {
      text-align: center;
      margin-top: 20px;
      font-size: 10px;
      color: #666;
    }

    @media print {
      body {
        padding: 0;
        margin: 0;
      }
      .print-container {
        max-width: 100%;
        margin: 0;
      }
      .no-print {
        display: none;
      }
    }

    .action-buttons {
      text-align: center;
      margin: 20px 0;
      gap: 10px;
      display: flex;
      justify-content: center;
    }

    .btn {
      padding: 8px 16px;
      background: #2563eb;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 600;
    }

    .btn:hover {
      background: #1d4ed8;
    }

    .btn-secondary {
      background: #6b7280;
    }

    .btn-secondary:hover {
      background: #4b5563;
    }
  </style>
</head>
<body>
  <div class="print-container">
    <div class="header">
      <h1>MUGS CAFE</h1>
      <div class="date-time">
        Date: <%= new Date().toLocaleDateString() %><br>
        Time: <%= new Date().toLocaleTimeString() %>
      </div>
    </div>

    <% if (allSales && allSales.length > 0) { %>
      <% allSales.forEach((sale, index) => { %>
        <div class="order-item">
          <div class="order-row">
            <span class="label">Order:</span>
            <span class="value">#<%= sale.id %></span>
          </div>
          <div class="order-row">
            <span class="label">Room:</span>
            <span class="value"><%= sale.room_number %></span>
          </div>
          <div class="order-row">
            <span class="label">Staff:</span>
            <span class="value"><%= sale.staff_name || sale.staff_id || 'Unknown' %></span>
          </div>
          <div class="order-row">
            <span class="label">Time:</span>
            <span class="value"><%= new Date(sale.created_at).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %></span>
          </div>
          <div class="order-row">
            <span class="label">Details:</span>
            <span class="value"><%= sale.order_details %></span>
          </div>
          <div class="amount">
            Amount: <%= sale.amount %> UGX
          </div>
        </div>
      <% }) %>

      <div class="summary">
        <div class="summary-row">Total Orders: <%= allSales.length %></div>
        <div class="summary-row">Total Amount: <%= totalSales || 0 %> UGX</div>
      </div>
    <% } else { %>
      <div style="text-align: center; padding: 40px 20px; font-size: 13px;">
        No sales records to print
      </div>
    <% } %>

    <div class="footer">
      <p>Thank you for your business!</p>
    </div>
  </div>

  <div class="action-buttons no-print">
    <button class="btn" onclick="window.print()"><i class="fa fa-print"></i> Print</button>
    <button class="btn btn-secondary" onclick="window.history.back()"><i class="fa fa-arrow-left"></i> Back</button>
  </div>
</body>
</html>
