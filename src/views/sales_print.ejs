<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sales Print - <%= new Date().toLocaleDateString() %></title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Courier New', monospace;
      background: white;
      padding: 20px;
      color: #000;
    }

    .print-container {
      max-width: 80mm;
      margin: 0 auto;
      background: white;
      padding: 10px;
    }

    .header {
      text-align: center;
      margin-bottom: 15px;
      border-bottom: 2px dashed #000;
      padding-bottom: 10px;
    }

    .header h1 {
      font-size: 14px;
      font-weight: bold;
      margin-bottom: 3px;
    }

    .header .subtitle {
      font-size: 10px;
      color: #333;
      margin-bottom: 5px;
    }

    .order-item {
      margin-bottom: 15px;
      padding-bottom: 10px;
      border-bottom: 1px dashed #999;
    }

    .order-item:last-child {
      border-bottom: 2px dashed #000;
    }

    .detail-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 5px;
      line-height: 1.4;
      font-size: 11px;
    }

    .label {
      font-weight: bold;
      width: 45%;
    }

    .value {
      word-break: break-word;
      text-align: right;
      width: 55%;
    }

    .room-section {
      background: #f0f0f0;
      padding: 8px;
      margin-bottom: 10px;
      border: 2px solid #000;
      text-align: center;
    }

    .room-label {
      font-size: 10px;
      color: #666;
      margin-bottom: 3px;
    }

    .room-number {
      font-size: 22px;
      font-weight: bold;
      color: #000;
    }

    .description-section {
      background: #fff9e6;
      border: 2px solid #ffc107;
      padding: 8px;
      margin-bottom: 10px;
    }

    .description-label {
      font-size: 10px;
      font-weight: bold;
      color: #666;
      margin-bottom: 5px;
    }

    .description-text {
      font-size: 22px;
      font-weight: bold;
      color: #000;
      line-height: 1.5;
      word-break: break-word;
    }

    .amount-section {
      background: #f0f0f0;
      padding: 10px;
      text-align: center;
      border-top: 2px dashed #000;
      border-bottom: 2px dashed #000;
      margin-bottom: 10px;
    }

    .amount-label {
      font-size: 10px;
      color: #666;
      margin-bottom: 3px;
    }

    .amount-value {
      font-size: 14px;
      font-weight: bold;
      color: #000;
    }

    .summary {
      margin-top: 20px;
      text-align: center;
      border-top: 2px dashed #000;
      border-bottom: 2px dashed #000;
      padding: 10px 0;
    }

    .summary-row {
      font-size: 12px;
      font-weight: bold;
      margin: 5px 0;
    }

    .footer {
      text-align: center;
      font-size: 10px;
      color: #666;
      margin-top: 10px;
    }

    @media print {
      body {
        padding: 0;
        margin: 0;
      }

      .print-container {
        max-width: 100%;
        margin: 0;
      }

      .app-sidebar {
        display: none;
      }

      .no-print, .btn {
        display: none;
      }

      footer, .app-header {
        display: none;
      }
    }

    .action-buttons {
      text-align: center;
      margin: 20px 0;
      gap: 10px;
      display: flex;
      justify-content: center;
    }

    .btn {
      padding: 8px 16px;
      background: #2563eb;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 600;
    }

    .btn:hover {
      background: #1d4ed8;
    }

    .btn-secondary {
      background: #6b7280;
    }

    .btn-secondary:hover {
      background: #4b5563;
    }
  </style>
</head>
<body>
  <div class="print-container">
    <div class="header">
      <h1>FIGOZ CAFE</h1>
      <div class="subtitle">
        <%= new Date().toLocaleDateString() %> - <%= new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %>
      </div>
    </div>

    <% if (allSales && allSales.length > 0) { %>
      <% allSales.forEach((sale, index) => { %>
        <div class="order-item">
          <!-- Room Number - Bold & Clear -->
          <div class="room-section">
            <div class="room-label">ROOM</div>
            <div class="room-number"><%= sale.room_number %></div>
          </div>

          <!-- Order Details -->
          <div class="description-section">
            <div class="description-label">ORDER DETAILS</div>
            <div class="description-text"><%= sale.order_details %></div>
          </div>

          <!-- Amount -->
          <div class="amount-section">
            <div class="amount-label">AMOUNT</div>
            <div class="amount-value"><%= sale.amount %> UGX</div>
          </div>

          <!-- Additional Info -->
          <div style="font-size: 11px; line-height: 1.4;">
            <div class="detail-row">
              <span class="label">Order ID:</span>
              <span class="value">#<%= sale.id %></span>
            </div>
            <div style="font-size: 20px; text-decoration: solid;" class="detail-row">
              <span class="label">Staff:</span>
              <b><span class="value"><%= sale.staff_name || sale.staff_id || 'Unknown' %></span></b>
            </div>
            <div style="font-size: 20px; text-decoration: solid;" class="detail-row">
              <span class="label">Time:</span>
              <b><span class="value"><%= new Date(sale.created_at).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %></span></b>
            </div>
          </div>
        </div>
      <% }) %>

      <div class="summary">
        <div class="summary-row">Total Orders: <%= allSales.length %></div>
        <div class="summary-row">Total Amount: <%= totalSales || 0 %> UGX</div>
      </div>
    <% } else { %>
      <div style="text-align: center; padding: 40px 20px; font-size: 13px;">
        No sales records to print
      </div>
    <% } %>

    <div class="footer">
      <p>Thank you for your business!</p>
      <p style="margin-top: 8px; font-size: 9px; border-top: 1px solid #ccc; padding-top: 8px;">© 2026 FIGOZ CAFE. All rights reserved.</p>
    </div>
  </div>

  <div class="action-buttons no-print">
    <button class="btn" onclick="window.print()"><i class="fa fa-print"></i> Print</button>
    <button class="btn btn-secondary" onclick="window.history.back()"><i class="fa fa-arrow-left"></i> Back</button>
  </div>
</body>
</html>
