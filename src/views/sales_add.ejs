<div class="form-wrapper">
  <div class="form-card card form-small">
    <h2>Add Sale</h2>
    <form method="POST" action="/sales">
      <label>Amount</label>
      <input name="amount" type="number" step="0.01" required>

      <label>Room number</label>
      <input name="room_number" type="text" required>

      <label>Order details</label>
      <textarea name="order_details" rows="3" required></textarea>

      <label>Staff ID</label>
      <input name="staff_id" type="number">

      <div class="form-actions">
        <button type="submit">Create Sale</button>
        <a class="button secondary" href="/sales">Cancel</a>
      </div>
    </form>
  </div>
</div>
